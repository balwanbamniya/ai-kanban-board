{
	"name": "@repo/frontend",
	"version": "0.0.0",
	"private": true,
	"description": "TanStack Start frontend for AI Kanban Board",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"build": "vite build",
		"start": "node .output/server/index.mjs",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check-types": "tsc --noEmit",
		"dev": "vite dev --port 3000",
		"test": "vitest run",
		"test:smoke": "node scripts/smoke.mjs"
	},
	"dependencies": {
		"@clerk/tanstack-react-start": "^1.5.11",
		"@dnd-kit/react": "^0.5.0",
		"@fontsource/dm-sans": "^5.3.0",
		"@fontsource/dm-serif-display": "^5.3.0",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@tanstack/react-devtools": "0.10.12",
		"@tanstack/react-query": "^5.102.8",
		"@tanstack/react-router": "1.170.32",
		"@tanstack/react-router-devtools": "1.167.1",
		"@tanstack/react-start": "1.168.49",
		"lucide-react": "^1.39.0",
		"nitro": "3.0.260903-beta",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"socket.io-client": "4.8.3"
	},
	"devDependencies": {
		"@repo/typescript-config": "workspace:*",
		"@tailwindcss/vite": "4.3.3",
		"@tanstack/devtools-vite": "0.8.5",
