		"@testing-library/react": "16.3.3",
		"@types/node": "catalog:",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@vitejs/plugin-react": "6.1.1",
		"jsdom": "30.0.1",
		"tailwindcss": "4.3.3",
		"typescript": "catalog:",
		"vite": "8.2.2",
		"vitest": "catalog:"
	}
