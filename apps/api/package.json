{
	"name": "@repo/api",
	"version": "0.0.0",
	"private": true,
	"description": "NestJS API for AI Kanban Board",
	"type": "module",
	"scripts": {
		"build": "nest build",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:dev": "prisma migrate dev",
		"db:reset": "prisma migrate reset",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"db:validate": "prisma validate",
		"dev": "nest start --watch",
		"generate": "prisma generate",
		"start": "nest start",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main.js",
		"test": "vitest run --config vitest.config.ts",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:ai:live": "tsx scripts/smoke-ai.ts",
		"test:integration:local": "node scripts/integration-local.mjs"
	},
	"dependencies": {
		"@clerk/backend": "3.17.1",
		"@nestjs/common": "12.0.1",
		"@nestjs/config": "12.0.0",
		"@nestjs/core": "12.0.1",
		"@nestjs/platform-express": "12.0.1",
		"@nestjs/platform-socket.io": "12.0.1",
		"@nestjs/swagger": "12.0.1",
		"@nestjs/websockets": "12.0.1",
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/auto-instrumentations-node": "0.79.0",
		"@opentelemetry/resources": "2.10.0",
		"@opentelemetry/sdk-node": "0.221.0",
		"@opentelemetry/semantic-conventions": "1.43.0",
		"@prisma/adapter-pg": "7.10.0",
		"@prisma/client": "7.10.0",
		"@socket.io/redis-adapter": "8.3.0",
		"class-transformer": "0.5.1",
		"class-validator": "0.15.1",
		"dotenv": "17.4.2",
		"fractional-indexing": "4.0.0",
		"helmet": "8.3.0",
		"openai": "7.9.0",
		"pg": "8.23.0",
		"pino-http": "11.0.0",
		"redis": "6.2.1",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2",
		"socket.io": "4.8.3",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@nestjs/cli": "12.0.0",
		"@nestjs/schematics": "12.0.0",
		"@nestjs/testing": "12.0.1",
		"@repo/typescript-config": "workspace:*",
		"@types/express": "5.0.6",
		"@types/node": "catalog:",
		"@types/pg": "8.23.1",
		"@types/supertest": "7.2.1",
		"prisma": "7.10.0",
		"socket.io-client": "4.8.3",
		"supertest": "7.2.2",
		"tsx": "4.23.12",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
