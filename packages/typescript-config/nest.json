{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "./base.json",
	"compilerOptions": {
		"declaration": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"incremental": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"removeComments": true,
		"resolvePackageJsonExports": true,
		"sourceMap": true,
		"types": ["node"],
		"verbatimModuleSyntax": true
	}
}
